---
/** Card-head icons. Add a new one here and to ICONS in src/content.config.ts. */
import type { ICONS } from '../content.config';
interface Props { name: (typeof ICONS)[number] }
const { name } = Astro.props;
---
<div class="card-icon">
  {name === 'robot' && (
    <Fragment set:html={`<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="8" width="14" height="10" rx="2"/><path d="M12 8V5"/><circle cx="12" cy="3.5" r="1.2"/><circle cx="9" cy="13" r="1.2"/><circle cx="15" cy="13" r="1.2"/><path d="M9 18v2M15 18v2"/></svg>`} />
  )}
  {name === 'book' && (
    <Fragment set:html={`<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 5.5A1.5 1.5 0 0 1 5.5 4H11v15H5.5A1.5 1.5 0 0 0 4 20.5z"/><path d="M20 5.5A1.5 1.5 0 0 0 18.5 4H13v15h5.5A1.5 1.5 0 0 1 20 20.5z"/></svg>`} />
  )}
  {name === 'audit' && (
    <Fragment set:html={`<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M7 3h7l4 4v8"/><path d="M14 3v4h4"/><path d="M6 13h5"/><path d="M6 16.5h3"/><circle cx="15.5" cy="17.5" r="3"/><path d="M17.8 19.8 21 23"/></svg>`} />
  )}
  {name === 'wrench' && (
    <Fragment set:html={`<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a4 4 0 0 0-5.4 5.4L3 18l3 3 6.3-6.3a4 4 0 0 0 5.4-5.4l-2.3 2.3-2.1-.6-.6-2.1z"/></svg>`} />
  )}
  {name === 'network' && (
    <Fragment set:html={`<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="4" r="2"/><circle cx="5" cy="13" r="2"/><circle cx="19" cy="13" r="2"/><circle cx="12" cy="20" r="2"/><path d="M12 6v0M10.5 5.2 6.5 11.4M13.5 5.2l4 6.2M6.4 14.6 10.6 19M17.6 14.6 13.4 19"/></svg>`} />
  )}
  {name === 'globe' && (
    <Fragment set:html={`<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M3 12h18"/><path d="M12 3a14 14 0 0 1 0 18a14 14 0 0 1 0-18z"/></svg>`} />
  )}
  {name === 'comic' && (
    <Fragment set:html={`<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 12h18M12 3v18"/></svg>`} />
  )}
  {name === 'podcast' && <img src="/assets/ai-laboratory-podcast-icon.png" alt="AI Laboratory Podcast">}
</div>
