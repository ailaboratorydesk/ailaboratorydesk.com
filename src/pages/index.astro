---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Consulting from '../components/Consulting.astro';
import ConsultingCta from '../components/ConsultingCta.astro';
import CaseStudyCard from '../components/CaseStudyCard.astro';
import About from '../components/About.astro';
import Contact from '../components/Contact.astro';
import { getCaseStudies } from '../lib/case-studies';

const studies = await getCaseStudies();
---
<BaseLayout home path="/">
  <Hero />
  <Consulting />

  <section class="section" id="work">
    <div class="wrap">
      <div class="section-head">
        <div class="section-eyebrow">The Work</div>
        <h2 class="section-title">Projects, start to finish</h2>
        <p class="section-lead">Each project took on a new field — the unfamiliar, made familiar. Tap any card to open the full case study.</p>
      </div>

      <div class="cards">
        {studies.map((entry) => <CaseStudyCard entry={entry} />)}
      </div>

      <ConsultingCta />
    </div>
  </section>

  <About />
  <Contact />
</BaseLayout>
