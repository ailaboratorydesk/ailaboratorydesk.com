---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Consulting from '../components/Consulting.astro';
import ConsultingCta from '../components/ConsultingCta.astro';
import ProjectCarousel from '../components/ProjectCarousel.astro';
import CategoryGrid from '../components/CategoryGrid.astro';
import About from '../components/About.astro';
import Contact from '../components/Contact.astro';
import { getCaseStudies } from '../lib/case-studies';
import { getCategories } from '../lib/categories';

const studies = await getCaseStudies();
const categories = await getCategories();
const featured = categories.map((c) => c.featuredStudy);
const featuredLabels = categories.map((c) => c.name);
---
<BaseLayout home path="/">
  <Hero />
  <Consulting />

  <section class="section" id="work">
    <div class="wrap">
      <div class="section-head">
        <div class="section-eyebrow">The Work</div>
        <h2 class="section-title">Projects, start to finish</h2>
        <p class="section-lead">Each project took on a new field — the unfamiliar, made familiar. Start with a featured project from each category, browse by category, or search the full library.</p>
      </div>

      <ProjectCarousel studies={featured} labels={featuredLabels} indicators="thumbs" counterLabel="CH" label="Featured projects, one per category" />

      <div class="work-sub">
        <h3 class="consult-sub" id="categories">Browse by category</h3>
        <a class="work-all" href="/work/">Browse all {studies.length} projects <span class="arr">→</span></a>
      </div>
      <CategoryGrid categories={categories} />

      <ConsultingCta />
    </div>
  </section>

  <About />
  <Contact />
</BaseLayout>
