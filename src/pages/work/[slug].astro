---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CaseStudyCard from '../../components/CaseStudyCard.astro';
import StudyCard from '../../components/StudyCard.astro';
import { formatDate, getCaseStudies, type CaseStudy } from '../../lib/case-studies';
import { categoriesOf, categoryHref, relatedTo } from '../../lib/categories';
import { SITE } from '../../data/site';

export async function getStaticPaths() {
  const studies = await getCaseStudies();
  return studies.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

interface Props { entry: CaseStudy }
const { entry } = Astro.props;
const d = entry.data;
const all = await getCaseStudies();
const cats = categoriesOf(entry);
const related = relatedTo(entry, all);
---
<BaseLayout
  title={`${d.title} — ${SITE.name} — ${SITE.author}`}
  description={d.oneLiner}
  path={`/work/${entry.id}/`}
  ogImage={d.cover.src}
  ogImageAlt={d.cover.alt}
  ogType="article"
>
  <main class="section">
    <div class="wrap">
      <div class="section-head">
        <div class="section-eyebrow">Case Study · <time class="cs-date" datetime={d.date}>{formatDate(d.date)}</time></div>
        <div class="cs-cats" aria-label="Categories">{cats.map((c) => <a class="chip-link" href={categoryHref(c.slug)}>{c.name}</a>)}</div>
      </div>
      <CaseStudyCard entry={entry} mode="page" />
      {related.length > 0 && (
        <section class="related" aria-labelledby="related-h">
          <div class="related-head">
            <h2 class="consult-sub" id="related-h">Related projects</h2>
            <a class="work-all" href="/work/">Browse all projects <span class="arr">→</span></a>
          </div>
          <div class="related-row">{related.map((s) => <StudyCard study={s} size="sm" />)}</div>
        </section>
      )}
      <div class="cs-page-actions">
        <a class="btn btn-secondary" href="/work/"><span class="arr">←</span> All projects</a>
        <a class="btn btn-primary" href="/#contact">Request a Consultation <span class="arr">→</span></a>
      </div>
    </div>
  </main>
</BaseLayout>
